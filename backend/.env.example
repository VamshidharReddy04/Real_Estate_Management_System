# BACKEND CONFIGURATION
#
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env file to git (it's in .gitignore)
#
# Instructions for each variable:
# - MONGO_URI: Get from MongoDB Atlas connection string
# - CLOUDINARY_*: Get from Cloudinary dashboard
# - JWT_SECRET: Generate random string: openssl rand -base64 32
# - CLIENT_URL: Your Vercel frontend URL

# DATABASE
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/realEstateDB?retryWrites=true&w=majority

# SERVER
PORT=5000
NODE_ENV=production

# JWT AUTHENTICATION
JWT_SECRET=your_super_secret_jwt_key_here_generate_random_string_minimum_32_characters
JWT_EXPIRE=7d

# FRONTEND URL (for CORS)
CLIENT_URL=https://your-vercel-frontend-url.vercel.app

# CLOUDINARY (Image Hosting)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
