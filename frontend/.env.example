# FRONTEND API CONFIGURATION
#
# LOCAL DEVELOPMENT:
#   Copy this file to .env.local
#   Set VITE_API_URL=/api (uses Vite proxy configured in vite.config.js)
#
# PRODUCTION (Vercel):
#   Vercel will use environment variables set in Project Settings
#   Set VITE_API_URL=https://your-render-backend.onrender.com/api

VITE_API_URL=/api
